# ========== MyBooks 自身（沿用你现在的设置）==========
# ★ 用 -full 版：在 build.09 基础上补装了全局 AI 助手依赖（langchain/langgraph）
#   并加入了本地语音输入（麦克风）功能。见完整包说明。
MYBOOKS_IMAGE=mybooks:4.7.0-build.09-full
HTTP_PORT=9800
HTTPS_PORT=8443
# ★★ 数据目录：必须是【绝对路径】。已按你 NAS 实际情况预填（截图里的存储空间挂载）。
#    install.sh 启动时会再自动从旧容器探测一次覆盖，双保险。
#    你的数据目录 /volume1/docker/audiobook-data 是独立目录，不在 audiobook 程序目录内，
#    所以改名 audiobook → audiobook.old 完全不影响数据。
DATA_DIR=/volume1/docker/audiobook-data
# ★ PUID/PGID 按你截图填（群晖 1026/100）。填错会导致上传失败、设置存不下。
PUID=1026
PGID=100
TZ=Asia/Shanghai
# HuggingFace 镜像：MyNexus 下 embedding 模型 + 本地语音首次下 whisper 模型，都要走它
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# ========== MyNexus ↔ MyBooks 连接 ==========
# 两边通信的密钥，随便设一长串随机字符串（install.sh 会自动生成覆盖占位符）。
MYNEXUS_API_TOKEN=在这里填你的MYNEXUS_API_TOKEN
MYNEXUS_AUTO_URL=http://mynexus
MYNEXUS_PORT=3000
MYNEXUS_IMAGE=poxenstudio/mynexus:latest

# ========== LLM 配置（两个 AI 功能统一用 OpenRouter）==========
# ★ URL 统一：两个 AI 功能都填 https://openrouter.ai/api/v1（不带 /chat/completions！）
#   客户端会自动拼 /chat/completions；填完整路径会变成 .../chat/completions/chat/completions → 404。
# ★ 模型统一：openrouter/free —— 自动路由到当前可用的免费模型，避开单模型限流
#   （你之前用的 baidu/ernie 只有 1 个供应商，一限流就没得切，反复报错的根源）。
# ★ Key：填你自己的 OpenRouter key（sk-or-v1- 开头）。出于安全不预填，只留占位符。
LLM_PROVIDER=openai
LLM_API_KEY=sk-or-v1-你的OpenRouter密钥
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free

# 全局 AI 助手（顶部导航 AI 按钮）：与 MyNexus 共用同一个 OpenRouter key 和模型。
# AI_MCP_TOKEN 沿用你截图里的值（MyBooks 内部 MCP 服务令牌，一般不用改）。
AI_API_KEY=sk-or-v1-你的OpenRouter密钥
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_MCP_TOKEN=在这里填你的AI_MCP_TOKEN

# —— 备选：改用本地 Ollama（数据不出内网，需另装 Ollama 并拉模型）——
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://宿主IP:11434
# LLM_MODEL=llama3
