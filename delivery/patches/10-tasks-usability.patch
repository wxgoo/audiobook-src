 tests/test_background_tasks.py           | 37 +++++++++++
 webserver/handlers/admin.py              |  9 +++
 webserver/services/background_service.py | 83 ++++++++++++++++++++++--
 3 files changed, 125 insertions(+), 4 deletions(-)
