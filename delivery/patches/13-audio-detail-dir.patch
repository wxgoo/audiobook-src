+        """
         if uid is None:
             return {"status": "unavailable", "msg": _("登录后才能查看音频"), "count": 0}
 
@@ -260,12 +264,12 @@ class AudioUtils:
             AudioUtils.site_url = BaseHandler.get_site_url()
 
