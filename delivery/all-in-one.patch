+++ b/tests/test_search_index.py
@@ -0,0 +1,91 @@
+"""独立中文检索索引的回归：
+
+- 汉字逐字进索引、整段做精确过滤，保证 1~2 字查询能命中；
+- calibre 高级语法（author:xxx、#tag:）仍交给原生 search；
+- 从 metadata.db 建索引后，能够按中文/英文检索，并支持重建。
+"""
+
+import sqlite3
+
+import pytest
+
+from webserver.services.search_index import (
+    SearchIndexService,
+    build_match_expression,
+    build_search_tokens,
+    looks_like_advanced_query,
+    tokenize_text,
+)
+
+
+def test_chinese_is_tokenized_per_char():
+    terms, parts = tokenize_text("三体")
+    assert terms == ["三", "体"]
+    assert parts == ["三体"]
+
+
+def test_match_expression_uses_and_and_prefix_for_latin():
+    expr = build_match_expression(["三", "体", "harry"])
+    assert expr == '"三" AND "体" AND "harry"*'
+
+
+def test_advanced_calibre_syntax_falls_back():
+    assert looks_like_advanced_query('author:"刘慈欣"')
+    assert looks_like_advanced_query("#tag:科幻")
+    assert looks_like_advanced_query("三体 AND 刘慈欣")
+    assert not looks_like_advanced_query("三体")
+    assert not looks_like_advanced_query("harry potter")
+
+
+def test_build_tokens_splits_cjk_only():
+    tokens = build_search_tokens("三体", "刘慈欣")
+    assert tokens == "三 体 刘 慈 欣"
+
+
+@pytest.fixture()
+def library(tmp_path):
+    """最小的 calibre metadata.db 结构。"""
+    library_dir = tmp_path / "library"
+    library_dir.mkdir()
+    db = sqlite3.connect(str(library_dir / "metadata.db"))
+    db.executescript(
+        """
+        CREATE TABLE books (id INTEGER PRIMARY KEY, title TEXT, sort TEXT,
+                            publisher INTEGER, series INTEGER);
+        CREATE TABLE authors (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE books_authors_link (book INTEGER, author INTEGER);
+        CREATE TABLE tags (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE books_tags_link (book INTEGER, tag INTEGER);
+        CREATE TABLE publishers (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE series (id INTEGER PRIMARY KEY, name TEXT);
+        CREATE TABLE comments (book INTEGER, text TEXT);
+        """
+    )
+    db.execute("INSERT INTO authors VALUES (1, '刘慈欣')")
+    db.execute("INSERT INTO books VALUES (1, '三体（全集）', 'san ti', NULL, NULL)")
+    db.execute("INSERT INTO books VALUES (2, 'Harry Potter and the Philosopher', 'harry', NULL, NULL)")
+    db.execute("INSERT INTO books_authors_link VALUES (1, 1)")
+    db.execute("INSERT INTO comments VALUES (1, '演播：李野墨。地球往事三部曲第一部。')")
+    db.commit()
+    db.close()
+    return library_dir
+
+
+def test_rebuild_and_search_chinese(library, tmp_path):
+    service = SearchIndexService(path=str(tmp_path / "search_index.db"),
+                                 library_dir=str(library))
+    result = service.rebuild(force=True)
+    assert result["ok"] and result["docs"] == 2
+
+    # 2 字书名：逐字 AND + 原文精确过滤
+    assert service.search("三体") == [1]
+    # 1 个字也能命中，但必须真的包含这个字
+    assert service.search("体") == [1]
+    # 演播者写在简介里，也能搜到
+    assert service.search("李野墨") == [1]
+    # 英文前缀
+    assert 2 in service.search("harr")
+    # 不存在的词
+    assert service.search("红楼梦") == []
+    # calibre 高级语法交回原生搜索
+    assert service.search("author:刘慈欣") is None
diff --git a/tests/test_search_index_async.py b/tests/test_search_index_async.py
new file mode 100644
index 0000000..ae11473
--- /dev/null
+++ b/tests/test_search_index_async.py
@@ -0,0 +1,165 @@
+"""cached_search_async 的线程化回归：FTS 查询不允许阻塞事件循环。
+
+build.20 之前 `get_search_index().search(query)` 直接跑在 ioloop 线程上，
+索引大、查询复杂时会把这个进程里所有请求一起卡住。这里用「可控阻塞的
+FTS 查询 + 心跳协程」证明检索在工作线程里进行，且慢检索期间事件循环
+仍然能推进（不是靠读代码保证）。
+
+语义约束（与改造前一致）：结果顺序原样返回、不排序不去重；FTS 返回
+None 时回退 calibre；异常照常向上抛且不写缓存。
+"""
+
+import asyncio
+import threading
+
+from webserver.handlers import base as base_module
+from webserver.handlers.base import BaseHandler
+
+GATE_TIMEOUT = 5.0
+
+
+class _FakeCache:
+    """只实现 cached_search_async 用到的 get/put。"""
+
+    def __init__(self):
+        self.data = {}
+        self.puts = 0
+
+    def get(self, query, version):
+        return self.data.get((query, version))
+
+    def put(self, query, version, ids):
+        self.puts += 1
+        self.data[(query, version)] = ids
+
+
+class _FakeHandler:
+    """只实现 cached_search_async 依赖的接口，避免拉起完整 Tornado 请求。"""
+
+    def __init__(self, cache=None, calibre_result=()):
+        self.cache = cache if cache is not None else _FakeCache()
+        self.calibre_result = calibre_result
+        self.calibre_calls = 0
+        outer = self
+
+        class _CalibreCache:
+            def search(self, query):
+                outer.calibre_calls += 1
+                return outer.calibre_result
+
+        self.calibre_db_cache = _CalibreCache()
+
+    def library_version(self):
+        return 1
+
+    def search_cache(self):
+        return self.cache
+
+    async def run_calibre_read_async(self, func, *args, **kwargs):
+        return func(*args, **kwargs)
+
+    async def search(self, query):
+        return await BaseHandler.cached_search_async(self, query)
+
+
+def _patch_index(monkeypatch, search_impl):
+    class FakeIndex:
+        search = staticmethod(search_impl)
+
+    monkeypatch.setattr(base_module, "get_search_index", lambda: FakeIndex())
+
+
+def test_slow_fts_search_does_not_block_event_loop(monkeypatch):
+    """FTS 卡住时：其它协程照常推进，检索本身在非事件循环线程上执行。"""
+    calls = []
+    worker_threads = []
+    entered = threading.Event()
+    release = threading.Event()
+
+    def slow_search(query):
+        calls.append(query)
+        worker_threads.append(threading.get_ident())
+        entered.set()
+        if not release.wait(GATE_TIMEOUT):
+            raise RuntimeError("FTS 闸门超时：检索没有在独立工作线程上执行")
+        return [3, 1, 2]     # 故意不是升序，用于断言顺序原样返回
+
+    _patch_index(monkeypatch, slow_search)
+    handler = _FakeHandler()
+
+    async def scenario():
+        ticks = 0
+        heartbeat_done = asyncio.Event()
+
+        async def heartbeat():
+            nonlocal ticks
+            while not heartbeat_done.is_set():
+                ticks += 1
+                await asyncio.sleep(0.001)
+
+        async def wait_entered():
+            while not entered.is_set():
+                await asyncio.sleep(0.001)
+
+        hb = asyncio.create_task(heartbeat())
+        search_task = asyncio.create_task(handler.search("慢查询"))
+        try:
+            await asyncio.wait_for(wait_entered(), GATE_TIMEOUT)
+            # FTS 已进入工作线程并停在闸门里，请求协程在等它
+            assert not search_task.done()
+            assert worker_threads[0] != threading.get_ident(), "FTS 仍在事件循环线程上执行"
+            assert ticks > 0
+
+            # 事件循环在慢检索期间继续跑：心跳计数必须继续增长
+            before = ticks
+            await asyncio.sleep(0.05)
+            assert ticks > before, "慢检索期间事件循环被阻塞，心跳没有推进"
+            assert not search_task.done()
+
+            release.set()
+            assert await asyncio.wait_for(search_task, GATE_TIMEOUT) == [3, 1, 2]
+        finally:
+            release.set()
+            heartbeat_done.set()
+            await hb
+
+    asyncio.run(scenario())
+
+    # 结果整串写入缓存：顺序保留、未排序未去重
+    assert handler.cache.puts == 1
+    assert handler.cache.get("慢查询", 1) == (3, 1, 2)
+    assert handler.calibre_calls == 0
+
+    # 第二次读命中缓存，不再触发检索
+    assert asyncio.run(handler.search("慢查询")) == [3, 1, 2]
+    assert calls == ["慢查询"]
+    assert len(set(worker_threads)) == 1
+
+
+def test_fts_none_falls_back_to_calibre(monkeypatch):
+    """FTS 返回 None（索引缺失/高级语法）时回退 calibre，语义与改造前一致。"""
+    _patch_index(monkeypatch, lambda query: None)
+    handler = _FakeHandler(calibre_result=("b", "a"))
+
+    assert asyncio.run(handler.search("q")) == ["b", "a"]
+    assert handler.calibre_calls == 1
+    assert handler.cache.puts == 1
+
+
+def test_fts_exception_propagates_and_is_not_cached(monkeypatch):
+    """改造前异常直接向上抛；线程化后仍是同一条路径，且不写缓存。"""
+    def boom(query):
+        raise RuntimeError("fts broke")
+
+    _patch_index(monkeypatch, boom)
+    handler = _FakeHandler(calibre_result=("x",))
+
+    try:
+        asyncio.run(handler.search("q"))
+    except RuntimeError as exc:
+        assert str(exc) == "fts broke"
+    else:  # pragma: no cover - 失败时给出明确原因
+        raise AssertionError("FTS 异常被吞掉了，回退语义发生变化")
+
+    assert handler.cache.puts == 0
+    assert handler.calibre_calls == 0
diff --git a/tests/test_version_lock.py b/tests/test_version_lock.py
new file mode 100644
index 0000000..3e137a6
--- /dev/null
+++ b/tests/test_version_lock.py
@@ -0,0 +1,128 @@
+# -*- coding: utf-8 -*-
+"""版本锁（防反弹）回归测试。
+
+背景：本 fork 自本版起把运行期版本统一为 `4.6.0-build.20`（上游已发布 tag 4.6.0
++ 第 20 次本地构建），旧 `4.8.x` 号段封存。这里的用例把这条约定钉死：任何
+回退（写回 4.8.x、写回裸 4.6.0）、被构建参数顶成空串、Dockerfile/Makefile
+守卫被删除，都必须失败。
+
+失败时打印的说明是「防版本回退 / 防被交付标签覆盖的保护，不是普通测试失败」，
+不要通过删除或放宽断言来让它变绿。
+"""
+
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+CHECKER = ROOT / "scripts" / "check-version-lock.py"
+LOCK = "4.6.0-build.20"
+FILES = [
+    "webserver/version.py",
+    "docker-compose.yml",
+    "Dockerfile",
+    "app/package.json",
+    "app/package-lock.json",
+    "Makefile",
+]
+
+
+def run(root):
+    return subprocess.run(
+        [sys.executable, str(CHECKER), "--root", str(root)],
+        capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=60)
+
+
+def make_fixture(tmp_path):
+    for rel in FILES:
+        src = ROOT / rel
+        dst = tmp_path / rel
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(src, dst)
+    return tmp_path
+
+
+def mutate(root, rel, old, new):
+    p = root / rel
+    text = p.read_text(encoding="utf-8")
+    assert old in text, "fixture 里找不到要替换的内容: %s" % old
+    p.write_text(text.replace(old, new, 1), encoding="utf-8")
+
+
+def test_repo_passes_version_lock():
+    r = run(ROOT)
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert "版本锁检查通过" in r.stdout
+
+
+def test_version_py_rollback_to_4_8_is_rejected(tmp_path):
+    """回退到已封存的 4.8.x 号段必须被拦住。"""
+    root = make_fixture(tmp_path)
+    mutate(root, "webserver/version.py", 'VERSION = "%s"' % LOCK, 'VERSION = "v4.8.0"')
+    r = run(root)
+    assert r.returncode == 1, r.stdout
+    assert "防版本回退" in r.stdout
+    assert "补救" in r.stdout
+
+
+def test_version_py_bare_upstream_tag_is_rejected(tmp_path):
+    """写成不带 -build.20 的裸 4.6.0 也必须被拦住（那是上游 tag，不是我们的构建号）。"""
+    root = make_fixture(tmp_path)
+    mutate(root, "webserver/version.py", 'VERSION = "%s"' % LOCK, 'VERSION = "4.6.0"')
+    r = run(root)
+    assert r.returncode == 1, r.stdout
+    assert "防版本回退" in r.stdout
+
+
+def test_empty_git_version_is_rejected(tmp_path):
+    root = make_fixture(tmp_path)
+    mutate(root, "docker-compose.yml", 'GIT_VERSION: "%s"' % LOCK, 'GIT_VERSION: ""')
+    r = run(root)
+    assert r.returncode == 1, r.stdout
+    assert "GIT_VERSION 为空" in r.stdout
+
+
+def test_compose_mismatch_is_rejected(tmp_path):
+    root = make_fixture(tmp_path)
+    mutate(root, "docker-compose.yml", 'GIT_VERSION: "%s"' % LOCK, 'GIT_VERSION: "4.6.0"')
+    r = run(root)
+    assert r.returncode == 1, r.stdout
+    assert "docker-compose.yml" in r.stdout
+    assert "GIT_VERSION" in r.stdout
+
+
+def test_package_json_rollback_is_rejected(tmp_path):
+    root = make_fixture(tmp_path)
+    mutate(root, "app/package.json", '"version": "%s"' % LOCK, '"version": "4.8.0"')
+    r = run(root)
+    assert r.returncode == 1, r.stdout
+    assert "app/package.json" in r.stdout
+    assert "semver" in r.stdout
+
+
+def test_package_lock_mismatch_is_rejected(tmp_path):
+    root = make_fixture(tmp_path)
+    mutate(root, "app/package-lock.json", '"version": "%s"' % LOCK, '"version": "4.8.0"')
+    r = run(root)
+    assert r.returncode == 1, r.stdout
+    assert "package-lock.json" in r.stdout
+
+
+def test_dockerfile_empty_guard_missing_is_rejected(tmp_path):
+    root = make_fixture(tmp_path)
+    mutate(root, "Dockerfile",
+           'if [ -z "${GIT_VERSION:-}" ]; then echo "ERROR: GIT_VERSION 为空，触发版本锁保护'
+           '（见 scripts/check-version-lock.py）" >&2; exit 1; fi; \\',
+           'if true; then :; fi; \\')
+    r = run(root)
+    assert r.returncode == 1, r.stdout
+    assert "缺少「GIT_VERSION 为空则构建失败」的守卫" in r.stdout
+
+
+def test_makefile_ver_guard_missing_is_rejected(tmp_path):
+    root = make_fixture(tmp_path)
+    mutate(root, "Makefile", "ifneq ($(strip $(VER)),$(VERSION_LOCK))", "ifeq (1,1)")
+    r = run(root)
+    assert r.returncode == 1, r.stdout
+    assert "VER 不匹配时没有报错退出" in r.stdout
