+"""后台任务可读错误与重试提示的回归。"""
+
+from webserver.services.background_service import BackgroundTask, humanize_error
+
+
+def test_humanize_error_is_single_line_and_bounded():
+    raw = "Traceback:\n  line1\n  line2\n" + "x" * 400
+    msg = humanize_error(raw)
+    assert "\n" not in msg
+    assert len(msg) <= 300
+
+
