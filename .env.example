# 全新安装用：cp .env.example .env 后按自己机器改。
# docker compose 会自动读取仓库根目录的 .env；不填任何变量就用
# docker-compose.yml 里的默认值（作者群晖布局），现有站点完全无感。
#
# .env 是本地配置，不要提交：scripts/install-fresh.sh 会自动把它写进
# .git/info/exclude。别人的机器重点改 DATA_DIR 与 PUID/PGID 两项。

# 固定 compose 项目名，保证容器名是 audiobook-mybooks-1
# （deploy.sh 的启动验证按这个名字找容器；否则会随 clone 的目录名变化）。
COMPOSE_PROJECT_NAME=audiobook

# 数据目录（绝对路径）。必须事先存在，或由 install-fresh.sh 创建。
# ★ 绝不能指向源码目录本身 ★ —— 那是 build context，不是 /data。
#   见 docs/部署方式速查.md §2.5。
DATA_DIR=/volume1/docker/audiobook-data

# 宿主机端口：http://<IP>:HTTP_PORT 、 https://<IP>:HTTPS_PORT
# 8443 走容器内 443，证书是自签 demo；不需要就把 compose 里 443 那行注释掉。
HTTP_PORT=9800
HTTPS_PORT=8443

# 数据目录所有者的 uid/gid：SSH 里执行 id 查看。
# 群晖常见 1026/100，普通 Linux 常见 1000/1000。填错会「上传不了书」。
PUID=1026
PGID=100

TZ=Asia/Shanghai
