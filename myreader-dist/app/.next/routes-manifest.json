{
  "version": 3,
  "pages404": true,
  "appType": "hybrid",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "regex": "^/\\.well-known/apple-app-site-association(?:/)?$"
    },
    {
      "source": "/reader/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, max-age=0, must-revalidate"
        }
      ],
      "regex": "^/reader(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/readerx/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, max-age=0, must-revalidate"
        }
      ],
      "regex": "^/readerx(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/_next/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "regex": "^/_next/static(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/reader/:ids",
        "destination": "/reader?ids=:ids",
        "regex": "^/reader(?:/([^/]+?))(?:/)?$"
      },
      {
        "source": "/o/book/:hash/annotation/:id",
        "destination": "/o?book=:hash&note=:id",
        "regex": "^/o/book(?:/([^/]+?))/annotation(?:/([^/]+?))(?:/)?$"
      },
      {
        "source": "/s/:token",
        "destination": "/s?token=:token",
        "regex": "^/s(?:/([^/]+?))(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/mybooks/avatar/[...path]",
      "regex": "^/api/mybooks/avatar/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/mybooks/avatar/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/api/mybooks/cover/[...path]",
      "regex": "^/api/mybooks/cover/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/mybooks/cover/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/api/mybooks/mydict/res/[...path]",
      "regex": "^/api/mybooks/mydict/res/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/mybooks/mydict/res/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/api/mybooks/proxy/[...path]",
      "regex": "^/api/mybooks/proxy/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/mybooks/proxy/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/api/mybooks/site-dict/[...path]",
      "regex": "^/api/mybooks/site\\-dict/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/mybooks/site\\-dict/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/reader/[ids]",
      "regex": "^/reader/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPids": "nxtPids"
      },
      "namedRegex": "^/reader/(?<nxtPids>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
